{
  "crons": [
    {
      "path": "/api/cron/weekly-recognition",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/outreach-followups",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/document-render",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/automation-retry",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/voice-shield/console",
      "destination": "https://voiceshield-live.vercel.app/"
    },
    {
      "source": "/voice-shield/console/:path*",
      "destination": "https://voiceshield-live.vercel.app/:path*"
    }
  ]
}
