# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# security and secrets
*.key
*.secret

# test artifacts and development scratch files
*.log
*.txt
*.py
!services/**/*.py
!services/**/requirements.txt
*.yaml
available_models.*
models.json
test_*
debug_*
proxy_*
*_output.*
*_response.*
scripts/

# Large stray media files at root

*.jpeg
*.jpg
!public/**/*.jpg
!public/**/*.jpeg
.ipynb_checkpoints/
.vscode/
