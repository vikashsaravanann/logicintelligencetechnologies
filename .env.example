# Public browser variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase variables
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

# Zoho SMTP — per-sender credentials (app passwords)
# no-reply@
SMTP_NOREPLY_HOST=smtp.zoho.in
SMTP_NOREPLY_PORT=587
SMTP_NOREPLY_SECURE=false
SMTP_NOREPLY_USER=no-reply@logicintelligencetechnologies.in
SMTP_NOREPLY_PASS=<your_zoho_app_password>
SMTP_NOREPLY_FROM="Logic Intelligence Technologies <no-reply@logicintelligencetechnologies.in>"

# vikash@
SMTP_VIKASH_HOST=smtp.zoho.in
SMTP_VIKASH_PORT=587
SMTP_VIKASH_SECURE=false
SMTP_VIKASH_USER=vikash@logicintelligencetechnologies.in
SMTP_VIKASH_PASS=<your_zoho_app_password>
SMTP_VIKASH_FROM="Vikash Saravanan <vikash@logicintelligencetechnologies.in>"

# hello@
SMTP_HELLO_HOST=smtp.zoho.in
SMTP_HELLO_PORT=587
SMTP_HELLO_SECURE=false
SMTP_HELLO_USER=hello@logicintelligencetechnologies.in
SMTP_HELLO_PASS=<your_zoho_app_password>
SMTP_HELLO_FROM="Logic Intelligence Technologies <hello@logicintelligencetechnologies.in>"


# admin@
SMTP_ADMIN_HOST=smtp.zoho.in
SMTP_ADMIN_PORT=587
SMTP_ADMIN_SECURE=false
SMTP_ADMIN_USER=admin@logicintelligencetechnologies.in
SMTP_ADMIN_PASS=<your_zoho_app_password>
SMTP_ADMIN_FROM="Logic Intelligence Technologies <admin@logicintelligencetechnologies.in>"

# support@
SMTP_SUPPORT_HOST=smtp.zoho.in
SMTP_SUPPORT_PORT=587
SMTP_SUPPORT_SECURE=false
SMTP_SUPPORT_USER=support@logicintelligencetechnologies.in
SMTP_SUPPORT_PASS=<your_zoho_app_password>
SMTP_SUPPORT_FROM="Logic Intelligence Technologies <support@logicintelligencetechnologies.in>"

# Fallback (legacy single SMTP config - kept for backward compatibility)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=<your_zoho_app_password>
SMTP_FROM=
SMTP_REPLY_TO=
LEAD_NOTIFICATION_EMAIL=

# Optional server-side rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email platform
# mock | smtp  — mock never delivers
EMAIL_PROVIDER=smtp
EMAIL_DRY_RUN=false
# HMAC secret for unsubscribe tokens (falls back to CRON_SECRET)
EMAIL_UNSUBSCRIBE_SECRET=
# Allow preview deployments to email non-company addresses (default false)
EMAIL_ALLOW_PREVIEW=false
CRON_SECRET=
ADMIN_ALERT_EMAIL=admin@logicintelligencetechnologies.in
