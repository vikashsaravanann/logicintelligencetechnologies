+function getGoogleClient() {
+  const email = process.env.GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL;
+  const key = process.env.GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY;
+  // Handle standard Service Account auth or API key fallback
+  if (key && key.startsWith('AIza')) {
+    return google.searchconsole({ version: 'v1', auth: key });
+  }
+  const auth = new google.auth.GoogleAuth({ credentials: { client_email: email, private_key: key }, scopes: ['https://www.googleapis.com/auth/webmasters'] });
+  return google.searchconsole({ version: 'v1', auth });
+}
