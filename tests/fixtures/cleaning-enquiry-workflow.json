    {
      "parameters": {
        "jsCode": "const c=$('Validate AI Output').first().json; const url=c.booking_url; if(typeof url!=='string'||!/^https:\\/\\/cal\\.com\\/[^\\s]+$/.test(url))throw Error('Set a valid https://cal.com/ booking URL in Business Settings'); const name=(c.customer_name||'').replace(/[\\r\\n]/g,' ').slice(0,80); return [{json:{...c,action:'booking_link',booked:false,sent:false,offered_start:'',offered_end:'',calendar_event_id:'',reply_text:'Hi'+(name?' '+name:'')+', thanks for getting in touch. You can choose a time for a 30-minute cleaning estimate video consultation here: '+url+'\\n\\nComplete the booking on that page to reserve your appointment. You will receive your confirmation from Cal.com.'}}];"
      },
