      "id": "a78def7e-a512-44f4-afa3-a47eaf9fc589",
      "name": "Fetch Full Customer Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "webhookId": "e973ed19-f255-4e8a-9363-ff0842e7ec98",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Business Settings').first().json;\nconst x = {...cfg, ...$json};\nconst headers = x.payload?.headers || x.headers || {};\nconst h = name => {\n  const value = Array.isArray(headers)\n    ? headers.find(v => v.name.toLowerCase() === name)?.value\n    : headers[name];\n  return String(value || (typeof x[name] === 'string' ? x[name] : '')).replace(new RegExp('^'+name+':\\\\s*','i'), '');\n};\nconst raw = String(x.from?.value?.[0]?.address || x.from?.email || (typeof x.from === 'string' ? x.from : h('from')));\nconst email = raw.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i)?.[0]?.toLowerCase() || '';\nconst plain = p => {\n  if (p?.mimeType === 'text/plain' && p.body?.data) return Buffer.from(p.body.data, 'base64url').toString('utf8');\n  return (p?.parts || []).map(plain).filter(Boolean).join('\\n');\n};\nconst text = String(x.text || x.textPlain || plain(x.payload) || '');\nif (!text) throw Error('No full plain-text email body; manual review required');\nconst autoSubmitted = h('auto-submitted').trim().toLowerCase();\nconst automated = /mailer-daemon|postmaster/i.test(raw) || (autoSubmitted && autoSubmitted !== 'no') || /delivery status notification|undelivered/i.test(x.subject || h('subject'));\nif (x.demo_mode !== false) throw Error('Live mode must be explicitly false for demo_mode');\nif (!email || !x.id || !x.threadId) throw Error('Missing Gmail sender/id/threadId. Inspect Gmail output mapping.');\nif (x.business_email.startsWith('REPLACE') || x.sheet_id.startsWith('REPLACE')) throw Error('Configure business email and Sheet ID first.');\nreturn [{json:{...x,message_id:x.id,thread_id:x.threadId,customer_email:email,message:text,automated:Boolean(automated || email === x.business_email.toLowerCase() || email === x.owner_email.toLowerCase())}}];\n"
      },
